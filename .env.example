# ═══════════════════════════════════════════════════════════════════════
# 闪象 (ShanXiang) — Environment Variables
# ═══════════════════════════════════════════════════════════════════════
# 复制此文件为 .env 并填入实际值。
# 标记 [REQUIRED] 的变量在生产和本地都必须设置，缺失会导致启动失败。
# 标记 [PRODUCTION] 的变量在本地开发可选，但生产环境必须设置。

# ── Database (PostgreSQL) ──────────────────────────────────────────────

# [REQUIRED] PostgreSQL 连接字符串，使用 @prisma/adapter-pg 直连
# 本地: postgresql://user:pass@localhost:5432/shanxiang
# Vercel 推荐 Neon: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/shanxiang?sslmode=require
DATABASE_URL=

# ── NextAuth v5 (Authentication) ───────────────────────────────────────

# [REQUIRED] 加密 JWT session 的密钥，用 `openssl rand -hex 32` 生成
AUTH_SECRET=

# [PRODUCTION] Google OAuth 凭证，从 https://console.cloud.google.com/apis/credentials 获取
# 本地开发可用 demo@shanxiang.ai / demo123 的 Credentials 登录
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [PRODUCTION] NextAuth 回调基础 URL，一般为 https://yourdomain.com
# Vercel 部署时设为 https://your-project.vercel.app
# 本地默认 http://localhost:3000
NEXTAUTH_URL=

# ── AI Generation (Replicate) ──────────────────────────────────────────

# [REQUIRED] 从 https://replicate.com/account/api-tokens 获取
REPLICATE_API_KEY=

# [Optional] 模型版本，默认 black-forest-labs/flux-schnell
# REPLICATE_MODEL_VERSION=black-forest-labs/flux-schnell

# [Optional] Replicate webhook URL，用于异步接收生图结果
# REPLICATE_WEBHOOK_URL=https://yourdomain.com/api/webhooks/replicate

# ── Lemon Squeezy (Billing — Merchant of Record) ────────────────────────

# [PRODUCTION] Lemon Squeezy API Key，从 https://app.lemonsqueezy.com/settings/api 获取
LEMONSQUEEZY_API_KEY=

# [PRODUCTION] Store ID，从 https://app.lemonsqueezy.com/settings/stores 获取
LEMONSQUEEZY_STORE_ID=

# [PRODUCTION] Webhook Signing Secret，从 Store → Settings → Webhooks 获取
LEMONSQUEEZY_WEBHOOK_SECRET=

# [PRODUCTION] Lemon Squeezy Variant ID，创建 Product → Variant 后获取
# 客户端可见，必须以 NEXT_PUBLIC_ 前缀
NEXT_PUBLIC_LEMONSQUEEZY_PRO_VARIANT_ID=
NEXT_PUBLIC_LEMONSQUEEZY_BUSINESS_VARIANT_ID=

# [PREVIEW ONLY] 设为 1 才允许 Vercel Preview 创建 Lemon test checkout 并开权。
# 只写在 Vercel 的 Preview 环境。不要写入 Production。
# 生产库主机（ep-lingering-unit-ahm7ojop）上预发开权会被拒绝。
# FLASHANT_PREVIEW_BILLING=1

# ── App URL ────────────────────────────────────────────────────────────

# [PRODUCTION] 应用公开访问 URL，用于 Lemon Squeezy Checkout 回调等
# Vercel 示例: https://shanxiang.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Token Encryption ───────────────────────────────────────────────────

# [REQUIRED] AES-256-GCM 加密密钥，加密存储在 DB 中的平台 OAuth Token
# 用 `openssl rand -hex 32` 生成，必须为 64 个十六进制字符
TOKEN_ENCRYPTION_KEY=

# ── S3 / Object Storage (Product Image Uploads) ────────────────────────

# [Optional] S3 兼容存储配置。不设置则使用 AWS 默认凭证链。
# 推荐: Cloudflare R2（零出网费）、AWS S3、或 MinIO（私有部署）
# S3_REGION=auto
# S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=uploads
# S3_UPLOAD_PREFIX=products/
# S3_PUBLIC_URL=

# ── Platform Integrations ──────────────────────────────────────────────

# [Optional] Shopify OAuth 凭证，从 Shopify Partner Dashboard 获取
# 用于发布商品图到 Shopify 商店
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=

# [Optional] TikTok Shop OAuth 凭证，从 TikTok Shop Partner Center 获取
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=

# ── Email (Resend) ──────────────────────────────────────────────────────

# [PRODUCTION] Resend API Key，从 https://resend.com/api-keys 获取
# 用于发送密码重置邮件等事务邮件
# 开发环境未设置时，邮件内容仅打印到 console
# RESEND_API_KEY=re_xxx

# [Optional] 发件人地址，默认 "闪象 <noreply@flashant.ai>"
# RESEND_FROM=闪象 <noreply@flashant.ai>

# ── Creem content moderation (image prompts only — not billing) ────────
# Do not put a production Live key in this file or in Production env from this change.
# This block does not switch Lemon Squeezy off and does not enable Creem checkout.

# Creem API key used only for POST /v1/moderation/prompt.
# Test keys start with creem_test_ and call https://test-api.creem.io.
# Live keys start with creem_ (not creem_test_) and call https://api.creem.io.
# A Live key is not available yet. Preview smoke tests use a creem_test_ key.
# CREEM_API_KEY=

# Optional host override. true/1/yes/on → test-api.creem.io.
# false/0/no/off → api.creem.io. When unset, the key prefix selects the host.
# CREEM_TEST_MODE=

# enforce (default) or off.
# Default is enforce, including when this variable is unset.
# enforce: user-controlled prompt text is screened before image generation.
#   deny and flag both block the request (HTTP 400) and the model is not called.
#   Network errors, timeouts, and non-200 responses fail closed (HTTP 503).
#   If CREEM_API_KEY is missing, user-prompt generation returns 503.
#   It does not silently skip moderation.
#   Static style and scene templates are removed before the call and are not screened.
#   Requests with no user-controlled text are not sent to Creem.
# off: skip screening. Use only for local development without a Creem key.
#   Do not set off on production once a Live key exists.
# CREEM_MODERATION=
